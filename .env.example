# Copy to .env and fill in. The .env file is never committed.

# Required. Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# The built-in admin account.
ADMIN_NAME=mick
ADMIN_PASSWORD=change-this

# Comma-separated words. Each word becomes a password repeated three times,
# so "schaap" hands out "schaapschaapschaap". Kept out of the repository on
# purpose: these passwords are meant to be easy, not secret.
PASSWORD_WORDS=woord,ander,derde

# Host port for nginx. The public hostname and TLS are handled by NPM.
BINGO_PORT=9877

# Where the SQLite database lives on the host.
DATA_PATH=./data

# Set to 0 only when NOT serving over HTTPS (local development).
COOKIE_SECURE=1

# Seconds a player must wait between entering two numbers. 0 disables it.
DRAW_COOLDOWN_SECONDS=0
